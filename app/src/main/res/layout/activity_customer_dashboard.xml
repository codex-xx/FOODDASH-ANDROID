<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".CustomerDashboard">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FOOD DASH"
        android:textColor="@color/brand_primary_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <ImageButton
        android:id="@+id/btnViewActiveOrders"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="View Active Orders"
        android:src="@android:drawable/ic_menu_recent_history"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/brand_text" />

    <androidx.cardview.widget.CardView
        android:id="@+id/searchBarCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/brand_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleTextView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search"
                android:src="@android:drawable/ic_menu_search" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search for food or restaurants"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/brand_text"
                android:textColorHint="@color/brand_text_muted" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/restaurantsLabelTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Partner Restaurants"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchBarCardView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/restaurantsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/restaurantsLabelTextView" />

    <TextView
        android:id="@+id/selectedRestaurantTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="Mixed picks from partner restaurants"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/restaurantsRecyclerView" />

    <EditText
        android:id="@+id/deliveryAddressEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Delivery address"
        android:inputType="textPostalAddress"
        android:maxLines="2"
        android:padding="10dp"
        android:textColor="@color/brand_text"
        android:textColorHint="@color/brand_text_muted"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selectedRestaurantTextView" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/deliveryAddressEditText"
        app:layout_constraintBottom_toTopOf="@+id/vehicleRadioGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/productsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:padding="4dp" />

            <Button
                android:id="@+id/btnViewProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_margin="12dp"
                android:text="View Products"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/searchResultsScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:padding="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/searchRestaurantsSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Restaurants"
                        android:textColor="@color/brand_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/searchRestaurantsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/searchMenuSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Menu Items"
                        android:textColor="@color/brand_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/searchMenuItemsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/searchNoResultsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:text="No results found"
                        android:textColor="@color/brand_text_muted"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <ProgressBar
                android:id="@+id/loadingProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyMessageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No menu available"
                android:textColor="@color/brand_text_muted"
                android:textSize="16sp"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <RadioGroup
        android:id="@+id/vehicleRadioGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_section_panel"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/totalPriceTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="12dp"
        android:gravity="center">

        <RadioButton
            android:id="@+id/radioMotorcycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motorcycle"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/radioTricycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tricycle"
            android:layout_marginStart="16dp"/>

        <RadioButton
            android:id="@+id/radioCab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cab"
            android:layout_marginStart="16dp"/>

    </RadioGroup>

    <TextView
        android:id="@+id/totalPriceTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total: ₱0.00"
        android:textColor="@color/brand_primary_dark"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/orderTrackingLayout"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPlaceOrder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Review Cart"
        android:textColor="@color/white"
        app:backgroundTint="@color/brand_primary"
        app:layout_constraintBottom_toTopOf="@+id/orderTrackingLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:id="@+id/orderTrackingLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_section_panel"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Order Tracking"
            android:textColor="@color/brand_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/orderStatusTimelineTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No active order"
            android:textColor="@color/brand_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/driverLocationTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Driver location: waiting assignment"
            android:textColor="@color/brand_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bottom_nav_background"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:minHeight="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/tabHomeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Home"
            android:drawableTop="@drawable/ic_home"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/tabOrdersButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Orders"
            android:drawableTop="@drawable/ic_orders"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

        <FrameLayout
            android:id="@+id/tabCartContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/tabCartButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bottom_nav_tab_unselected"
                android:fontFamily="sans-serif-medium"
                android:minHeight="64dp"
                android:padding="6dp"
                android:text="Cart"
                android:drawableTop="@drawable/ic_shopping_cart"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tabCartBadgeTextView"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="-2dp"
                android:layout_marginTop="-2dp"
                android:background="@drawable/cart_badge_background"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabNotificationsContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/tabNotificationsButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bottom_nav_tab_unselected"
                android:drawableTop="@drawable/ic_notifications"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="64dp"
                android:padding="6dp"
                android:text="Notif"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabNotificationsBadgeTextView"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="-2dp"
                android:layout_marginEnd="-2dp"
                android:background="@drawable/cart_badge_background"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/tabProfileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Profile"
            android:drawableTop="@drawable/ic_profile"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>