<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/light_faded_orange">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Order Tracking"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/trackingStatusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/view_border"
        android:padding="12dp"
        android:text="No active order found yet." />

    <TextView
        android:id="@+id/trackingLocationTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/view_border"
        android:padding="12dp"
        android:text="Driver location: waiting assignment" />

</LinearLayout>
