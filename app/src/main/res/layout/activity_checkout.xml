<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_faded_orange"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checkout"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/checkoutAddressEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Delivery address"
            android:inputType="textPostalAddress"
            android:minLines="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Delivery Type"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/checkoutVehicleRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/checkoutRadioMotorcycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Motorcycle (fast, cheap)" />

            <RadioButton
                android:id="@+id/checkoutRadioTricycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tricycle (medium capacity)" />

            <RadioButton
                android:id="@+id/checkoutRadioCab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cab (bulk orders)" />

        </RadioGroup>

        <TextView
            android:id="@+id/checkoutSummaryTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/view_border"
            android:padding="12dp"
            android:text="Summary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirmPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Place Order" />

        <Button
            android:id="@+id/btnBackToCart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Back to Cart" />
    </LinearLayout>
</ScrollView>
