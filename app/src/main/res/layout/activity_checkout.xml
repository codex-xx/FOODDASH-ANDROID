<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_faded_orange">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checkout"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <EditText
                android:id="@+id/checkoutAddressEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Delivery address"
                android:inputType="textPostalAddress"
                android:minLines="2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Delivery Type"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/checkoutVehicleRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                    <RadioButton
                    android:id="@+id/checkoutRadioMotorcycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Motorcycle (fast, cheap)"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <RadioButton
                    android:id="@+id/checkoutRadioTricycle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tricycle (medium capacity)"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <RadioButton
                    android:id="@+id/checkoutRadioCab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cab (bulk orders)"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Payment Method"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/checkoutPaymentRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/checkoutRadioGCash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="GCash"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <RadioButton
                    android:id="@+id/checkoutRadioCod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COD (Cash on Delivery)"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />
            </RadioGroup>

            <TextView
                android:id="@+id/checkoutSummaryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/view_border"
                android:padding="12dp"
                android:text="Summary"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnConfirmPlaceOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Confirm and Place Order"
                android:textStyle="bold"
                android:textSize="18sp"
                android:padding="12dp" />

            <LinearLayout
                android:id="@+id/checkoutProcessingContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/checkoutPaymentProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/checkoutProcessingMessageTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Processing payment..."
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bottom_nav_background"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:minHeight="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/tabHomeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Home"
            android:drawableTop="@drawable/ic_home"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/tabOrdersButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Orders"
            android:drawableTop="@drawable/ic_orders"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

        <FrameLayout
            android:id="@+id/tabCartContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/tabCartButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bottom_nav_tab_selected"
                android:fontFamily="sans-serif-medium"
                android:minHeight="64dp"
                android:padding="6dp"
                android:text="Cart"
                android:drawableTop="@drawable/ic_shopping_cart"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tabCartBadgeTextView"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="-2dp"
                android:layout_marginTop="-2dp"
                android:background="@drawable/cart_badge_background"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabNotificationsContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/tabNotificationsButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bottom_nav_tab_unselected"
                android:drawableTop="@drawable/ic_notifications"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="64dp"
                android:padding="6dp"
                android:text="Notif"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tabNotificationsBadgeTextView"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="-2dp"
                android:layout_marginEnd="-2dp"
                android:background="@drawable/cart_badge_background"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/tabProfileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Profile"
            android:drawableTop="@drawable/ic_profile"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
