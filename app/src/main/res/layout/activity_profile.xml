<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/light_faded_orange">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/profileNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name:"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/profileEmailTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Email:" />

    <TextView
        android:id="@+id/profilePhoneTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Phone:" />

    <TextView
        android:id="@+id/profileRoleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Role:" />

    <TextView
        android:id="@+id/profileAddressTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Saved Address:" />

    <TextView
        android:id="@+id/profilePaymentTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Preferred Payment:" />

    <Button
        android:id="@+id/btnEditAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Edit Saved Address" />

    <Button
        android:id="@+id/btnChangePayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Change Preferred Payment" />

    <Button
        android:id="@+id/btnViewOrderHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="View Order History" />

    <Button
        android:id="@+id/btnLogoutFromProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Log out" />

    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bottom_nav_background"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/tabHomeButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="38dp"
            android:padding="0dp"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tabOrdersButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="38dp"
            android:padding="0dp"
            android:text="Orders"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/tabCartContainer"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/tabCartButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bottom_nav_tab_unselected"
                android:fontFamily="sans-serif-medium"
                android:minHeight="38dp"
                android:padding="0dp"
                android:text="Cart"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabCartBadgeTextView"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="-2dp"
                android:layout_marginTop="-2dp"
                android:background="@drawable/cart_badge_background"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/tabNotificationsButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="38dp"
            android:padding="0dp"
            android:text="Alerts"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tabProfileButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="38dp"
            android:padding="0dp"
            android:text="Profile"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
