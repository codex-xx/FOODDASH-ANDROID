<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_app_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/brand_primary_dark"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/profileNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileEmailTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Email:" />

            <TextView
                android:id="@+id/profilePhoneTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Phone:" />

            <TextView
                android:id="@+id/profileRoleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Role:" />

            <TextView
                android:id="@+id/profileAddressTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Saved Address:" />

            <TextView
                android:id="@+id/profilePaymentTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Preferred Payment:" />

            <Button
                android:id="@+id/btnEditAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/brand_primary"
                android:text="Edit Saved Address" />

            <Button
                android:id="@+id/btnChangePayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/brand_primary"
                android:text="Change Preferred Payment" />

            <Button
                android:id="@+id/btnLogoutFromProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/brand_surface"
                android:textColor="@color/brand_primary"
                android:text="Log out" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bottom_nav_background"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:minHeight="80dp">

        <Button
            android:id="@+id/tabHomeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Home"
            android:drawableTop="@drawable/ic_home"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/tabOrdersButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Orders"
            android:drawableTop="@drawable/ic_orders"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

        <FrameLayout
            android:id="@+id/tabCartContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/tabCartButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bottom_nav_tab_unselected"
                android:fontFamily="sans-serif-medium"
                android:minHeight="64dp"
                android:padding="6dp"
                android:text="Cart"
                android:drawableTop="@drawable/ic_shopping_cart"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tabCartBadgeTextView"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="-2dp"
                android:layout_marginTop="-2dp"
                android:background="@drawable/cart_badge_background"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <Button
            android:id="@+id/tabNotificationsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Notif"
            android:drawableTop="@drawable/ic_notifications"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

        <Button
            android:id="@+id/tabProfileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bottom_nav_tab_unselected"
            android:fontFamily="sans-serif-medium"
            android:minHeight="64dp"
            android:padding="6dp"
            android:text="Profile"
            android:drawableTop="@drawable/ic_profile"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
